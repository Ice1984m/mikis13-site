<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport"
        content="width=device-width,initial-scale=1">
  <title>Mikis13 AI | Mikis13</title>
  <link rel="stylesheet" href="assets/style.css">
</head>
<body>
<header>
  <nav class="container">
    <a class="logo" href="index.html">MIKIS13</a>

    <div class="links">
      <a href="index.html">Start</a>
      <a href="pro.html">Mikis13 Pro</a>
      <a href="ai.html">Mikis13 AI</a>
      <a href="projecten.html">Projecten</a>
      <a href="status.html">Status</a>
    </div>
  </nav>
</header>
<main class="page container">
  <h1>Mikis13 AI</h1>
  
<section class="card">
  <h2>AI-programmeerhulp</h2>
  <p>
    Gebruik de tekstballon rechtsonder voor lokale hulp
    bij Termux, GitHub, DNS en GitHub Pages.
  </p>
  <p>
    De lokale tekstballon gebruikt geen API-sleutel.
    Voor echte generatieve AI opent de ChatGPT-knop
    ChatGPT in een afzonderlijk venster.
  </p>
  <div class="buttons">
    <a class="button primary"
       href="https://github.com/Ice1984m/mikis13-ai"
       target="_blank"
       rel="noopener noreferrer">
      Open AI-repository
    </a>

    <a class="button"
       href="https://chatgpt.com/"
       target="_blank"
       rel="noopener noreferrer">
      Vraag ChatGPT
    </a>
  </div>
</section>
</main>
<button id="chatButton"
        class="chat-button"
        aria-label="Open programmeerhulp">💬</button>

<section id="chatPanel" class="chat-panel">
  <div class="chat-header">Mikis13 programmeerhulp</div>

  <div id="chatMessages" class="chat-messages">
    <div class="message">
      Hallo! Vraag iets over Termux, GitHub, DNS of GitHub Pages.
    </div>
  </div>

  <form id="chatForm" class="chat-form">
    <input id="chatInput"
           placeholder="Typ je vraag…"
           autocomplete="off">
    <button class="button primary" type="submit">Stuur</button>
  </form>
</section>
<footer>
  <div class="container">
    Mikis13 — statische website zonder advertentietrackers.
  </div>
</footer>

<script src="assets/app.js"></script>
</body>
</html>
