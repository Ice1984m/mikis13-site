<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta
    name="description"
    content="Mikis13 Pro — websites, automatisering en slimme software."
  >
  <title>Mikis13 Pro</title>
  <link rel="stylesheet" href="assets/style.css">
</head>

<body>
  <header class="header">
    <a class="logo" href="#top">
      <span class="logo-mark">M13</span>
      <span>Mikis13 Pro</span>
    </a>

    <nav>
      <a href="#diensten">Diensten</a>
      <a href="#dashboard">Dashboard</a>
      <a href="#status">Status</a>
      <a href="goksites.html" target="_blank" rel="noopener">Goksites</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-copy">
        <span class="tag">Software • Automatisering • AI</span>

        <h1>
          Slimme digitale oplossingen voor jouw volgende project
        </h1>

        <p>
          Mikis13 Pro bouwt moderne websites, dashboards en
          automatiseringen die overzichtelijk en mobielvriendelijk zijn.
        </p>

        <div class="actions">
          <a class="button primary" href="#diensten">
            Bekijk diensten
          </a>

          <button class="button secondary" id="openBot">
            Open Order Bot
          </button>

          <a
            class="button secondary"
            href="goksites.html"
            target="_blank"
            rel="noopener"
          >
            Open goksites
          </a>
        </div>
      </div>

      <div class="hero-panel">
        <div class="live-line">
          <span class="pulse"></span>
          Systeemdashboard
        </div>

        <div class="metric-grid">
          <article>
            <span>Status</span>
            <strong id="systemStatus">Controleren…</strong>
          </article>

          <article>
            <span>Workers</span>
            <strong>20</strong>
          </article>

          <article>
            <span>Website</span>
            <strong>Online</strong>
          </article>

          <article>
            <span>Versie</span>
            <strong>2.0</strong>
          </article>
        </div>
      </div>
    </section>

    <section id="diensten" class="section">
      <div class="section-heading">
        <span class="tag">Mogelijkheden</span>
        <h2>Van idee tot werkend digitaal product</h2>
      </div>

      <div class="cards">
        <article class="card">
          <div class="icon">🌐</div>
          <h3>Websites</h3>
          <p>
            Snelle, moderne websites die goed werken op telefoon,
            tablet en computer.
          </p>
        </article>

        <article class="card">
          <div class="icon">⚙️</div>
          <h3>Automatisering</h3>
          <p>
            Werkstromen en tools die terugkerende handelingen
            eenvoudiger maken.
          </p>
        </article>

        <article class="card">
          <div class="icon">📊</div>
          <h3>Dashboards</h3>
          <p>
            Duidelijke statuspagina's voor taken, systemen,
            bestellingen en resultaten.
          </p>
        </article>
      </div>
    </section>

    <section id="dashboard" class="section control">
      <div>
        <span class="tag">Order Bot</span>
        <h2>Beheer de wachtrij vanaf je Android-toestel</h2>

        <p>
          De Order Bot draait lokaal in Termux op poort 8795.
          Start de server en open daarna het bedieningspaneel.
        </p>
      </div>

      <div class="control-actions">
        <button class="button primary" id="openDashboard">
          Wachtrij beheren
        </button>

        <button class="button secondary" id="checkDashboard">
          Verbinding controleren
        </button>
      </div>

      <div id="botMessage" class="message">
        Nog niet gecontroleerd.
      </div>
    </section>

    <section id="status" class="section">
      <div class="section-heading">
        <span class="tag">Live status</span>
        <h2>Platformonderdelen</h2>
      </div>

      <div class="status-list">
        <div>
          <span class="status-dot online"></span>
          <strong>GitHub Pages</strong>
          <span>Online</span>
        </div>

        <div>
          <span class="status-dot" id="botDot"></span>
          <strong>Lokale Order Bot</strong>
          <span id="botState">Niet gecontroleerd</span>
        </div>

        <div>
          <span class="status-dot online"></span>
          <strong>Mobiele website</strong>
          <span>Beschikbaar</span>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <strong>Mikis13 Pro</strong>
    <span>© <span id="year"></span> Matty Moors</span>
  </footer>

  <script src="assets/app.js"></script>
</body>
</html>
