<style>
.mikis-page-switcher {
    position: sticky;
    top: 0;
    z-index: 99999;
    width: 100%;
    border-bottom: 1px solid rgba(148, 163, 184, 0.22);
    background: rgba(2, 6, 23, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.22);
}

.mikis-page-switcher-inner {
    width: min(1180px, calc(100% - 24px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 66px;
}

.mikis-page-brand {
    flex: 0 0 auto;
    color: #38bdf8;
    font-weight: 900;
    letter-spacing: 0.14em;
    font-size: 0.88rem;
}

.mikis-page-links {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow-x: auto;
    padding: 10px 0;
    scrollbar-width: thin;
}

.mikis-page-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 15px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.82);
    color: #e2e8f0;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 750;
    transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
}

.mikis-page-link:hover,
.mikis-page-link:focus {
    transform: translateY(-2px);
    border-color: #38bdf8;
    background: rgba(14, 116, 144, 0.25);
    outline: none;
}

.mikis-page-link.active {
    border-color: #22c55e;
    background: rgba(34, 197, 94, 0.18);
    color: #ffffff;
    box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.2);
}

@media (max-width: 700px) {
    .mikis-page-switcher-inner {
        width: calc(100% - 16px);
        min-height: 58px;
        gap: 10px;
    }

    .mikis-page-brand {
        display: none;
    }

    .mikis-page-links {
        width: 100%;
    }

    .mikis-page-link {
        min-height: 38px;
        padding: 0 13px;
        font-size: 0.86rem;
    }
}
</style>
<!-- MIKIS13-PAGE-SWITCHER-END -->

